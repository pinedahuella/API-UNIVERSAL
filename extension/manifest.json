{
  "manifest_version": 3,
  "name": "API UNIVERSAL",
  "version": "1.0",
  "description": "Viste cualquier pagina que ya existe con el diseno que arma API UNIVERSAL.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://localhost:4321/*"
  ],
  "action": {
    "default_title": "API UNIVERSAL",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "iconos/icono16.png",
      "32": "iconos/icono32.png",
      "48": "iconos/icono48.png",
      "128": "iconos/icono128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "css": [
        "vestido.css"
      ],
      "js": [
        "iconos.js",
        "contenido.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "iconos/icono16.png",
    "32": "iconos/icono32.png",
    "48": "iconos/icono48.png",
    "128": "iconos/icono128.png"
  }
}