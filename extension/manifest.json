{
  "manifest_version": 3,
  "name": "API UNIVERSAL",
  "version": "1.0",
  "description": "Viste cualquier pagina que ya existe con el diseno que arma API UNIVERSAL.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://localhost:4321/*"
  ],
  "action": {
    "default_title": "API UNIVERSAL",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "css": ["vestido.css"],
      "js": ["contenido.js"],
      "run_at": "document_idle"
    }
  ]
}
